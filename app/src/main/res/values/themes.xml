<resources>
    <!-- Base application theme. -->
    <style name="Theme.AutoGrabber" parent="android:Theme.Material.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:statusBarColor">#0A1218</item>
        <item name="android:navigationBarColor">#0A1218</item>
    </style>

    <!-- Splash Screen theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen. -->
        <item name="windowSplashScreenBackground">#0A1218</item>
        <!-- Icon to be displayed in the center of the splash screen. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Duration of the splash screen (only for API 31+). -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Theme to use after the splash screen is dismissed. -->
        <item name="postSplashScreenTheme">@style/Theme.AutoGrabber</item>
    </style>
</resources>
